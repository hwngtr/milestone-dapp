// System architecture for the Milestone escrow-crowdfunding dApp.
// Layered top-to-bottom: user -> frontend -> edge -> node -> chain.
// Render: dot -Tsvg system-architecture.dot -o system-architecture.svg
//         dot -Tpng -Gdpi=200 system-architecture.dot -o system-architecture.png
digraph system_architecture {
  graph [
    rankdir=TB,
    splines=line,
    nodesep=0.35,
    ranksep=0.62,
    fontname="Arial",
    fontsize=11,
    bgcolor="#FBFAF7",
    compound=true,
    pad=0.25
  ];
  node [
    shape=box,
    style="rounded,filled",
    fontname="Arial",
    fontsize=11,
    color="#0F172A",
    penwidth=1.1,
    margin="0.16,0.10",
    width=2.15,
    height=0.72
  ];
  edge [
    fontname="Arial",
    fontsize=9,
    color="#475569",
    penwidth=1.0,
    arrowsize=0.7
  ];

  // ---- Layer 1: user ----------------------------------------------------
  subgraph cluster_user {
    label=<<B>USER SIDE</B>  ·  private keys never leave the device>;
    labeljust=l; fontsize=10; fontcolor="#64748B";
    style="rounded,dashed"; color="#94A3B8"; bgcolor="#FFFFFF";
    wallet [label=<<B>Browser + wallet</B><BR/><FONT POINT-SIZE="9">MetaMask · EIP-1193</FONT>>, fillcolor="#FFFFFF"];
  }

  // ---- Layer 2: frontend ------------------------------------------------
  subgraph cluster_app {
    label=<<B>FRONTEND</B>  ·  static bundle, no server-side state>;
    labeljust=l; fontsize=10; fontcolor="#64748B";
    style="rounded,dashed"; color="#94A3B8"; bgcolor="#FFFFFF";

    ui    [label=<<B>React + Vite</B><BR/><FONT POINT-SIZE="9">list · detail · create</FONT>>, fillcolor="#E8EEFB"];
    wagmi [label=<<B>wagmi + viem</B><BR/><FONT POINT-SIZE="9">wallet · chain · ABI</FONT>>, fillcolor="#E8EEFB"];
    eff   [label=<<B>Effect-TS tx machine</B><BR/><FONT POINT-SIZE="9">typed states + retries</FONT>>, fillcolor="#E8EEFB"];
    { rank=same; ui; eff; wagmi; }
    ui -> eff [style=invis];
    eff -> wagmi [style=invis];
  }

  // ---- Layer 3: Cloudflare edge ----------------------------------------
  subgraph cluster_edge {
    label=<<B>CLOUDFLARE EDGE</B>  ·  performance layer, holds no funds and no signing keys>;
    labeljust=l; fontsize=10; fontcolor="#1D4ED8";
    style="rounded,dashed"; color="#1D4ED8"; bgcolor="#F5F8FF";

    proxy [label=<<B>RPC proxy Worker</B><BR/><FONT POINT-SIZE="9">key hiding · call cache</FONT><BR/><FONT POINT-SIZE="9">rate limit</FONT>>, fillcolor="#E8EEFB"];
    api   [label=<<B>Read API Worker</B><BR/><FONT POINT-SIZE="9">campaign list, paged</FONT>>, fillcolor="#E8EEFB"];
    d1    [shape=cylinder, label=<<B>D1</B><BR/><FONT POINT-SIZE="9">event projection</FONT>>, fillcolor="#E8EEFB"];
    r2    [label=<<B>R2</B><BR/><FONT POINT-SIZE="9">covers · evidence</FONT><BR/><FONT POINT-SIZE="9">hash on-chain</FONT>>, fillcolor="#E8EEFB"];
    ts    [label=<<B>Turnstile</B><BR/><FONT POINT-SIZE="9">anti-spam on create</FONT>>, fillcolor="#E8EEFB"];
    { rank=same; api; proxy; d1; r2; ts; }
    api -> proxy [style=invis];
    proxy -> d1 [style=invis];
    d1 -> r2 [style=invis];
    r2 -> ts [style=invis];
  }

  // ---- Layer 4: node + indexer -----------------------------------------
  subgraph cluster_node {
    label=""; style="invis";
    node_rpc [label=<<B>JSON-RPC node</B><BR/><FONT POINT-SIZE="9">zkSync Sepolia (primary)</FONT><BR/><FONT POINT-SIZE="9">Ethereum Sepolia (baseline)</FONT>>, fillcolor="#FFFFFF", color="#1D4ED8", penwidth=1.8, width=2.5];
  }
  subgraph cluster_index {
    label=<<B>INDEXER</B>  ·  optional, rebuildable from chain history>;
    labeljust=l; fontsize=10; fontcolor="#B45309";
    style="rounded,dashed"; color="#B45309"; bgcolor="#FDF7EF";
    goidx [label=<<B>Go service</B><BR/><FONT POINT-SIZE="9">go-ethereum ethclient</FONT><BR/><FONT POINT-SIZE="9">logs → projections</FONT>>, fillcolor="#FDF1E3", width=2.5];
  }

  // ---- Layer 5: chain ---------------------------------------------------
  subgraph cluster_chain {
    label=<<B>ON-CHAIN</B>  ·  the only source of truth>;
    labeljust=r; fontsize=10; fontcolor="#0B6B4F";
    style="rounded"; color="#0B6B4F"; bgcolor="#EDF6F1"; penwidth=1.8;

    factory  [label=<<B>CampaignFactory</B><BR/><FONT POINT-SIZE="9">create · registry · clone</FONT>>, fillcolor="#FFFFFF", color="#0B6B4F"];
    campaign [label=<<B>Campaign (clone)</B><BR/><FONT POINT-SIZE="9">contribute · deliver · release</FONT><BR/><FONT POINT-SIZE="9">object · refund · pull payout</FONT>>, fillcolor="#FFFFFF", color="#0B6B4F", width=2.6];
    vault    [label=<<B>Fund custody</B><BR/><FONT POINT-SIZE="9">inside Campaign</FONT><BR/><FONT POINT-SIZE="9">liabilities == balance</FONT>>, fillcolor="#FFFFFF", color="#0B6B4F"];
    { rank=same; factory; campaign; vault; }
    factory -> campaign [label="deploy", style=dashed, color="#0B6B4F"];
    campaign -> vault [label="holds", dir=none, color="#0B6B4F", style=dotted];
  }

  // ---- Vertical flow ----------------------------------------------------
  wallet -> wagmi      [constraint=true];
  eff    -> proxy      [label="JSON-RPC writes", color="#1D4ED8"];
  ui     -> api        [label="reads", color="#1D4ED8"];
  ui     -> r2         [label="upload", style=dashed, color="#1D4ED8"];
  ui     -> ts         [label="token", style=dashed, color="#1D4ED8", constraint=false];
  proxy  -> node_rpc   [label="JSON-RPC", color="#1D4ED8", penwidth=1.4];
  goidx  -> d1         [label="upsert", color="#B45309", style=dashed];
  node_rpc -> campaign [label="tx · eth_call", color="#0B6B4F", penwidth=1.4];
  node_rpc -> factory  [color="#0B6B4F"];
  node_rpc -> goidx    [label="logs", color="#B45309", style=dashed, constraint=false];

  note [shape=note, style="filled", fillcolor="#FFF7E6", color="#B45309", width=3.4,
        label=<<B>Trust boundary</B><BR/><FONT POINT-SIZE="9">Everything above the node can lie, stall, or disappear.</FONT><BR/><FONT POINT-SIZE="9">Correctness is decided only inside ON-CHAIN.</FONT><BR/><FONT POINT-SIZE="9">If D1 is empty, the UI still reads the chain directly.</FONT>>];
  note -> node_rpc [style=invis];
  { rank=same; node_rpc; goidx; note; }
}
