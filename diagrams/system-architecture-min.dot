// Minimized system architecture for Milestone.
// One edge gateway Worker (/rpc, /api, /webhooks), D1 projection written only by the
// projection function, Cron reconciler as gap-closer and INV-1 checker. No Go indexer:
// ingest is webhook + cron, both inside the same Worker. See docs/03-architecture.md.
// Render: dot -Tpng -Gdpi=200 system-architecture-min.dot -o system-architecture-min.png
digraph system_architecture_min {
  graph [
    rankdir=TB,
    splines=line,
    nodesep=0.4,
    ranksep=0.55,
    fontname="Arial",
    fontsize=11,
    bgcolor="#FBFAF7",
    compound=true,
    pad=0.25
  ];
  node [
    shape=box,
    style="rounded,filled",
    fontname="Arial",
    fontsize=11,
    color="#0F172A",
    penwidth=1.1,
    margin="0.16,0.10",
    width=2.0,
    height=0.62
  ];
  edge [
    fontname="Arial",
    fontsize=9,
    color="#475569",
    penwidth=1.0,
    arrowsize=0.7
  ];

  subgraph cluster_user {
    label=<<B>USER SIDE</B>>;
    labeljust=l; fontsize=10; fontcolor="#64748B";
    style="rounded,dashed"; color="#94A3B8"; bgcolor="#FFFFFF";
    wallet [label=<<B>Browser + wallet</B><BR/><FONT POINT-SIZE="9">MetaMask · EIP-1193</FONT>>, fillcolor="#FFFFFF"];
  }

  subgraph cluster_app {
    label=<<B>FRONTEND</B>  ·  static bundle>;
    labeljust=l; fontsize=10; fontcolor="#64748B";
    style="rounded,dashed"; color="#94A3B8"; bgcolor="#FFFFFF";
    fe [label=<<B>React + Vite</B><BR/><FONT POINT-SIZE="9">wagmi · viem · Effect-TS tx machine</FONT>>, fillcolor="#E8EEFB"];
  }

  subgraph cluster_edge {
    label=<<B>CLOUDFLARE EDGE</B>  ·  one gateway Worker, holds no funds, no keys>;
    labeljust=l; fontsize=10; fontcolor="#1D4ED8";
    style="rounded,dashed"; color="#1D4ED8"; bgcolor="#F5F8FF";
    gw   [label=<<B>Edge gateway</B><BR/><FONT POINT-SIZE="9">/rpc allowlist · /api reads</FONT><BR/><FONT POINT-SIZE="9">/webhooks/alchemy (HMAC)</FONT>>, fillcolor="#E8EEFB", width=2.4];
    cron [label=<<B>Cron reconciler</B><BR/><FONT POINT-SIZE="9">getLogs replay · INV-1 check</FONT>>, fillcolor="#FDF1E3", color="#B45309", width=2.4];
    d1   [shape=cylinder, label=<<B>D1</B><BR/><FONT POINT-SIZE="9">event projection</FONT><BR/><FONT POINT-SIZE="9">one writer</FONT>>, fillcolor="#E8EEFB"];
    r2   [label=<<B>R2</B><BR/><FONT POINT-SIZE="9">covers · evidence</FONT><BR/><FONT POINT-SIZE="9">hash on-chain</FONT>>, fillcolor="#E8EEFB"];
    { rank=same; gw; cron; }
    { rank=same; d1; r2; }
  }

  node_rpc [label=<<B>JSON-RPC nodes</B><BR/><FONT POINT-SIZE="9">zkSync Sepolia · Ethereum Sepolia</FONT><BR/><FONT POINT-SIZE="9">ChainProvider port: Alchemy + fallback</FONT>>, fillcolor="#FFFFFF", color="#1D4ED8", penwidth=1.8, width=2.6];

  subgraph cluster_chain {
    label=<<B>ON-CHAIN</B>  ·  the only source of truth>;
    labeljust=r; fontsize=10; fontcolor="#0B6B4F";
    style="rounded"; color="#0B6B4F"; bgcolor="#EDF6F1"; penwidth=1.8;

    factory  [label=<<B>CampaignFactory</B><BR/><FONT POINT-SIZE="9">create · registry · clone</FONT>>, fillcolor="#FFFFFF", color="#0B6B4F"];
    campaign [label=<<B>Campaign (clone)</B><BR/><FONT POINT-SIZE="9">contribute · deliver · release</FONT><BR/><FONT POINT-SIZE="9">object · refund · pull payout</FONT>>, fillcolor="#FFFFFF", color="#0B6B4F", width=2.4];
    vault    [label=<<B>Fund custody</B><BR/><FONT POINT-SIZE="9">inside Campaign</FONT><BR/><FONT POINT-SIZE="9">no admin key</FONT>>, fillcolor="#FFFFFF", color="#0B6B4F"];
    { rank=same; factory; campaign; vault; }
    factory -> campaign [label="deploy", style=dashed, color="#0B6B4F"];
    campaign -> vault [label="holds", dir=none, color="#0B6B4F", style=dotted];
  }

  wallet -> fe      [constraint=true];
  fe     -> gw      [label="writes · reads", color="#1D4ED8"];
  fe     -> r2      [label="upload", style=dashed, color="#1D4ED8", constraint=false];
  gw     -> d1      [label="idempotent apply", color="#1D4ED8"];
  gw     -> node_rpc [label="JSON-RPC", color="#1D4ED8", penwidth=1.4];
  cron   -> node_rpc [label="eth_getLogs", style=dashed, color="#B45309"];
  node_rpc -> gw     [label="webhook events", style=dashed, color="#B45309", constraint=false];
  node_rpc -> factory  [color="#0B6B4F"];
  node_rpc -> campaign [label="tx · eth_call", color="#0B6B4F", penwidth=1.4];

  note [shape=note, style="filled", fillcolor="#FFF7E6", color="#B45309", width=3.2,
        label=<<B>Trust boundary</B><BR/><FONT POINT-SIZE="9">Everything above the node can lie, stall, or disappear.</FONT><BR/><FONT POINT-SIZE="9">Correctness is decided only inside ON-CHAIN.</FONT>>];
  note -> node_rpc [style=invis];
  { rank=same; node_rpc; note; }
}
